{
  "name": "fixmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "demo": "concurrently -k -n API,WEB \"npm run demo -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "seed": "npm run seed -w server",
    "indexes": "npm run indexes -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
