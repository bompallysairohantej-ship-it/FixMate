NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/fixmate?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_ENABLED=false
VECTOR_DIMENSIONS=768
KNOWLEDGE_INDEX=knowledge_vector
SERVICE_INDEX=services_vector
# Set only when running the seed command. No public administrator signup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_PASSWORD=
# Optional email delivery for password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FixMate <support@example.com>
